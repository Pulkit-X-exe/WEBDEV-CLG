{
  "info": {
    "_postman_id": "a9b3d240-8f12-4e4b-91a3-bidzone00123",
    "name": "BidZone API Collection",
    "description": "Comprehensive Postman collection for testing the BidZone Online Auction Platform REST API. Includes Auth (JWT Access & Refresh tokens), Auctions CRUD, RBAC, Aggregation Pipeline, Live Bids, and Error Handling tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User (Bidder)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"johndoe@test.com\",\n  \"password\": \"password123\",\n  \"role\": \"bidder\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login (Bidder) - Sets Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.accessToken) {",
                  "    pm.environment.set(\"bidderToken\", res.accessToken);",
                  "    pm.environment.set(\"refreshToken\", res.refreshToken);",
                  "    pm.environment.set(\"accessToken\", res.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bidder1@bidzone.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login (Seller) - Sets Seller Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.accessToken) {",
                  "    pm.environment.set(\"sellerToken\", res.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"seller@bidzone.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Refresh Access Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh-token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh-token"]
            }
          }
        },
        {
          "name": "Get Profile (Protected Route)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "profile"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Auctions (CRUD & RBAC)",
      "item": [
        {
          "name": "Get All Auctions",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.auctions && res.auctions.length > 0) {",
                  "    pm.environment.set(\"sampleAuctionId\", res.auctions[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auctions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auctions"]
            }
          }
        },
        {
          "name": "Filter Auctions by Category and Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auctions?category=Electronics&status=active",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auctions"],
              "query": [
                {
                  "key": "category",
                  "value": "Electronics"
                },
                {
                  "key": "status",
                  "value": "active"
                }
              ]
            }
          }
        },
        {
          "name": "Get Auction By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auctions/{{sampleAuctionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auctions", "{{sampleAuctionId}}"]
            }
          }
        },
        {
          "name": "Create Auction (RBAC: Seller Only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Sony PlayStation 5 Pro Edition\",\n  \"description\": \"Brand new 2TB Sony PS5 with 2 DualSense controllers in original packaging.\",\n  \"category\": \"Electronics\",\n  \"startingPrice\": 700,\n  \"imageUrl\": \"https://images.unsplash.com/photo-1606813907291-d86efa9b94db?w=600&auto=format&fit=crop&q=60\",\n  \"endTime\": \"2026-12-31T23:59:59.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auctions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auctions"]
            }
          }
        },
        {
          "name": "Get Category Sales Stats (Aggregation Pipeline)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auctions/stats/category-sales",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auctions", "stats", "category-sales"]
            }
          }
        },
        {
          "name": "Get My Auctions (Seller)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auctions/seller/my-auctions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auctions", "seller", "my-auctions"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Live Bidding",
      "item": [
        {
          "name": "Place a Bid (Protected)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bidderToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"auctionId\": \"{{sampleAuctionId}}\",\n  \"amount\": 5500\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bids",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bids"]
            }
          }
        },
        {
          "name": "Get Bids For Auction",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bids/auction/{{sampleAuctionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bids", "auction", "{{sampleAuctionId}}"]
            }
          }
        },
        {
          "name": "Get My Bids History (Protected)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bidderToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bids/my-bids",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bids", "my-bids"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Error Handling & Validation Tests",
      "item": [
        {
          "name": "400 Bad Request - Duplicate Email Registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Duplicate User\",\n  \"email\": \"seller@bidzone.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "401 Unauthorized - Access Protected Route without Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "profile"]
            }
          }
        },
        {
          "name": "403 Forbidden - Bidder attempts to Create Auction (RBAC violation)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bidderToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Unauthorized Item\",\n  \"description\": \"Bidder trying to post item\",\n  \"category\": \"Art\",\n  \"startingPrice\": 100,\n  \"endTime\": \"2026-12-31T23:59:59.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auctions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auctions"]
            }
          }
        },
        {
          "name": "400 Bad Request - Bid lower than current highest price",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bidderToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"auctionId\": \"{{sampleAuctionId}}\",\n  \"amount\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bids",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bids"]
            }
          }
        },
        {
          "name": "400 Bad Request - Invalid Mongo ID (CastError handling)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auctions/invalid-mongo-id-12345",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auctions", "invalid-mongo-id-12345"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "sellerToken",
      "value": ""
    },
    {
      "key": "bidderToken",
      "value": ""
    },
    {
      "key": "sampleAuctionId",
      "value": ""
    }
  ]
}
